# Needed from Phase 2 onward for real Supabase Auth.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Controls which DataClient implementation leagues/games/picks use.
# "mock" (default) needs no Supabase tables beyond auth + profiles.
# "supabase" switches to the real schema, wired in Phase 6.
VITE_DATA_SOURCE=mock
