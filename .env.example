# Needed from Phase 2 onward for real Supabase Auth.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Controls which DataClient implementation leagues/games/picks use.
# "mock" (default) needs no Supabase tables beyond auth + profiles.
# "supabase" switches to the real schema, wired in Phase 6.
VITE_DATA_SOURCE=mock

# Phase 7 only — used by scripts/sync-games.mjs and scripts/auto-assign-picks.mjs when run
# locally (node --env-file=.env). No VITE_ prefix on purpose: Vite only exposes VITE_-prefixed
# vars to the browser bundle, so this never ships to the client even though it's in the same file.
# In CI these come from GitHub Actions repo secrets instead, never from this file.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
